{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futpulse-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "vars": {
    "APP_ORIGIN": "https://supreme-potato-wv4pprg5r6p7c964v-5173.app.github.dev",
    "API_ORIGIN": "https://supreme-potato-wv4pprg5r6p7c964v-8787.app.github.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "futpulse-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
